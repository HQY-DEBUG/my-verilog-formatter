{
    "name": "my-verilog-formatter",
    "displayName": "Verilog Formatter",
    "description": "Verilog / SystemVerilog 代码格式化、模块例化、大纲识别、文件树、语法高亮与跳转工具",
    "version": "1.0.0",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Formatters",
        "Programming Languages",
        "Linters"
    ],
    "activationEvents": [
        "onLanguage:verilog",
        "onLanguage:systemverilog",
        "onLanguage:verilog-hdl",
        "onLanguage:systemverilog-hdl",
        "onLanguage:ucf",
        "onLanguage:xdc",
        "onLanguage:vhdl",
        "onLanguage:tcl",
        "onLanguage:modelsim-do",
        "onLanguage:gowin-cst",
        "onView:verilogFileTree",
        "workspaceContains:**/*.v",
        "workspaceContains:**/*.sv",
        "onView:verilogTodoTree",
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "verilog",
                "aliases": [
                    "Verilog",
                    "verilog"
                ],
                "extensions": [
                    ".v",
                    ".vh"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration-verilog.json"
            },
            {
                "id": "systemverilog",
                "aliases": [
                    "SystemVerilog",
                    "systemverilog"
                ],
                "extensions": [
                    ".sv",
                    ".svh"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration-verilog.json"
            },
            {
                "id": "ucf",
                "aliases": [
                    "UCF Constraint",
                    "ucf"
                ],
                "extensions": [
                    ".ucf"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration.json"
            },
            {
                "id": "xdc",
                "aliases": [
                    "XDC Constraint",
                    "xdc"
                ],
                "extensions": [
                    ".xdc"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration.json"
            },
            {
                "id": "vhdl",
                "aliases": [
                    "VHDL",
                    "vhdl"
                ],
                "extensions": [
                    ".vhd",
                    ".vhdl"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration-vhdl.json"
            },
            {
                "id": "tcl",
                "aliases": [
                    "Tcl",
                    "tcl"
                ],
                "extensions": [
                    ".tcl"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration.json"
            },
            {
                "id": "modelsim-do",
                "aliases": [
                    "ModelSim DO",
                    "do"
                ],
                "extensions": [
                    ".do"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration.json"
            },
            {
                "id": "gowin-cst",
                "aliases": [
                    "GoWin CST",
                    "cst"
                ],
                "extensions": [
                    ".cst"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration.json"
            }
        ],
        "snippets": [
            {
                "language": "verilog",
                "path": "./resources/verilog/snippets/verilog.code-snippets"
            },
            {
                "language": "systemverilog",
                "path": "./resources/verilog/snippets/verilog.code-snippets"
            }
        ],
        "grammars": [
            {
                "language": "verilog",
                "scopeName": "source.verilog",
                "path": "./resources/verilog/syntaxes/verilog.tmLanguage.json"
            },
            {
                "language": "verilog-hdl",
                "scopeName": "source.verilog.hdl",
                "path": "./resources/verilog/syntaxes/verilog.tmLanguage.json"
            },
            {
                "language": "systemverilog",
                "scopeName": "source.systemverilog",
                "path": "./resources/verilog/syntaxes/systemverilog.tmLanguage.json",
                "embeddedLanguages": {
                    "source.verilog": "verilog"
                }
            },
            {
                "language": "systemverilog-hdl",
                "scopeName": "source.systemverilog.hdl",
                "path": "./resources/verilog/syntaxes/systemverilog.tmLanguage.json",
                "embeddedLanguages": {
                    "source.verilog": "verilog-hdl"
                }
            },
            {
                "language": "ucf",
                "scopeName": "source.ucf",
                "path": "./resources/verilog/syntaxes/ucf.tmLanguage.json"
            },
            {
                "language": "xdc",
                "scopeName": "source.xdc",
                "path": "./resources/verilog/syntaxes/xdc.tmLanguage.json"
            },
            {
                "language": "vhdl",
                "scopeName": "source.vhdl",
                "path": "./resources/verilog/syntaxes/vhdl.tmLanguage.json"
            },
            {
                "language": "tcl",
                "scopeName": "source.tcl",
                "path": "./resources/verilog/syntaxes/tcl.tmLanguage.json"
            },
            {
                "language": "modelsim-do",
                "scopeName": "source.do",
                "path": "./resources/verilog/syntaxes/do.tmLanguage.json"
            },
            {
                "language": "gowin-cst",
                "scopeName": "source.cst",
                "path": "./resources/verilog/syntaxes/cst.tmLanguage.json"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "verilogFileTree",
                    "name": "Verilog 文件树",
                    "when": "workbenchState != empty"
                },
                {
                    "id": "verilogTodoTree",
                    "name": "TODO",
                    "when": "workbenchState != empty"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "verilogFormatter.refreshFileTree",
                    "when": "view == verilogFileTree",
                    "group": "navigation"
                },
                {
                    "command": "verilogFormatter.setTopModule",
                    "when": "view == verilogFileTree",
                    "group": "navigation"
                },
                {
                    "command": "verilogFormatter.todo.refresh",
                    "when": "view == verilogTodoTree",
                    "group": "navigation@1"
                },
                {
                    "command": "verilogFormatter.todo.collapseAll",
                    "when": "view == verilogTodoTree",
                    "group": "navigation@2"
                },
                {
                    "command": "verilogFormatter.todo.setViewTree",
                    "when": "view == verilogTodoTree",
                    "group": "navigation@3"
                },
                {
                    "command": "verilogFormatter.todo.setViewFlat",
                    "when": "view == verilogTodoTree",
                    "group": "navigation@4"
                },
                {
                    "command": "verilogFormatter.todo.setViewTags",
                    "when": "view == verilogTodoTree",
                    "group": "navigation@5"
                },
                {
                    "command": "verilogFormatter.todo.filterClear",
                    "when": "view == verilogTodoTree",
                    "group": "navigation@6"
                }
            ],
            "view/item/context": [
                {
                    "command": "verilogFormatter.todo.hidePath",
                    "when": "view == verilogTodoTree && viewItem == todoFile",
                    "group": "todo@1"
                },
                {
                    "command": "verilogFormatter.todo.hidePath",
                    "when": "view == verilogTodoTree && viewItem == todoFolder",
                    "group": "todo@1"
                },
                {
                    "command": "verilogFormatter.todo.resetPathFilter",
                    "when": "view == verilogTodoTree",
                    "group": "todo@2"
                }
            ],
            "editor/context": [
                {
                    "command": "verilogFormatter.instantiate",
                    "when": "editorLangId =~ /verilog|systemverilog/",
                    "group": "verilog@1"
                },
                {
                    "command": "verilogFormatter.generateTb",
                    "when": "editorLangId =~ /verilog|systemverilog/",
                    "group": "verilog@2"
                },
                {
                    "command": "verilogFormatter.ucfToXdc",
                    "when": "editorLangId == ucf",
                    "group": "verilog@3"
                }
            ]
        },
        "commands": [
            {
                "command": "verilogFormatter.instantiate",
                "title": "Verilog: 一键例化（复制到剪贴板）"
            },
            {
                "command": "verilogFormatter.generateTb",
                "title": "Verilog: 一键生成 Testbench"
            },
            {
                "command": "verilogFormatter.refreshFileTree",
                "title": "Verilog: 刷新文件树",
                "icon": "$(refresh)"
            },
            {
                "command": "verilogFormatter.setTopModule",
                "title": "Verilog: 设置顶层模块",
                "icon": "$(star)"
            },
            {
                "command": "verilogFormatter.rebuildIndex",
                "title": "Verilog: 重建符号索引"
            },
            {
                "command": "verilogFormatter.ucfToXdc",
                "title": "Verilog: UCF 转 XDC"
            },
            {
                "command": "verilogFormatter.incrementNumbers",
                "title": "Verilog: 数字递增 (+step)"
            },
            {
                "command": "verilogFormatter.decrementNumbers",
                "title": "Verilog: 数字递减 (-step)"
            },
            {
                "command": "verilogFormatter.todo.refresh",
                "title": "TODO: 刷新",
                "icon": "$(refresh)"
            },
            {
                "command": "verilogFormatter.todo.addTag",
                "title": "TODO: 添加标签"
            },
            {
                "command": "verilogFormatter.todo.removeTag",
                "title": "TODO: 删除标签"
            },
            {
                "command": "verilogFormatter.todo.diagnose",
                "title": "TODO: 诊断（显示当前扫描状态）"
            },
            {
                "command": "verilogFormatter.todo.goToNext",
                "title": "TODO: 跳到下一个"
            },
            {
                "command": "verilogFormatter.todo.goToPrevious",
                "title": "TODO: 跳到上一个"
            },
            {
                "command": "verilogFormatter.todo.setViewTree",
                "title": "TODO: 树视图",
                "icon": "$(list-tree)"
            },
            {
                "command": "verilogFormatter.todo.setViewFlat",
                "title": "TODO: 平铺列表",
                "icon": "$(list-flat)"
            },
            {
                "command": "verilogFormatter.todo.setViewTags",
                "title": "TODO: 按标签分组",
                "icon": "$(tag)"
            },
            {
                "command": "verilogFormatter.todo.filterClear",
                "title": "TODO: 清除过滤",
                "icon": "$(clear-all)"
            },
            {
                "command": "verilogFormatter.todo.collapseAll",
                "title": "TODO: 折叠全部",
                "icon": "$(collapse-all)"
            },
            {
                "command": "verilogFormatter.todo.hidePath",
                "title": "TODO: 隐藏此路径"
            },
            {
                "command": "verilogFormatter.todo.resetPathFilter",
                "title": "TODO: 重置路径过滤"
            }
        ],
        "keybindings": [
            {
                "command": "editor.action.formatDocument",
                "key": "ctrl+alt+f",
                "when": "editorTextFocus && editorLangId =~ /verilog|systemverilog/"
            },
            {
                "command": "verilogFormatter.instantiate",
                "key": "ctrl+alt+i",
                "when": "editorTextFocus && editorLangId =~ /verilog|systemverilog/"
            },
            {
                "command": "verilogFormatter.incrementNumbers",
                "key": "ctrl+alt+up",
                "when": "editorTextFocus"
            },
            {
                "command": "verilogFormatter.decrementNumbers",
                "key": "ctrl+alt+down",
                "when": "editorTextFocus"
            }
        ],
        "configuration": {
            "title": "Verilog Formatter",
            "properties": {
                "verilogFormatter.indentSize": {
                    "type": "number",
                    "default": 2,
                    "description": "缩进空格数（Verilog 风格规范：2 空格）"
                },
                "verilogFormatter.alignPortComment": {
                    "type": "boolean",
                    "default": true,
                    "description": "是否对齐端口行尾注释"
                },
                "verilogFormatter.newlineBeforeBegin": {
                    "type": "boolean",
                    "default": true,
                    "description": "begin 是否另起一行"
                },
                "verilogFormatter.hoverEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "是否启用悬停查看定义"
                },
                "verilogFormatter.lintEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否启用 xvlog 语法检查（需要配置 xvlog 环境变量）"
                },
                "verilogFormatter.lintSeverity": {
                    "type": "string",
                    "enum": [
                        "error",
                        "warning",
                        "info"
                    ],
                    "default": "warning",
                    "description": "语法检查最低报告级别"
                },
                "verilogFormatter.excludeFolders": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "ip",
                        "core",
                        "ipshared",
                        ".git"
                    ],
                    "description": "文件树和符号索引排除的文件夹名称"
                },
                "verilogFormatter.incrementStep": {
                    "type": "number",
                    "default": 1,
                    "description": "数字递增/递减的步长"
                },
                "verilogFormatter.formatOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "保存时自动格式化 Verilog/SystemVerilog 文件"
                },
                "verilogFormatter.todo.tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "TODO",
                        "FIXME",
                        "NOTE",
                        "HACK"
                    ],
                    "description": "TODO 扫描的标签关键字列表"
                },
                "verilogFormatter.todo.excludePatterns": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/node_modules/**",
                        "**/.git/**",
                        "**/out/**"
                    ],
                    "description": "TODO 扫描排除的 glob 模式"
                },
                "verilogFormatter.todo.showInStatusBar": {
                    "type": "boolean",
                    "default": true,
                    "description": "状态栏显示 TODO 总计数"
                },
                "verilogFormatter.todo.highlightEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "是否在编辑器中启用 TODO 行内高亮"
                },
                "verilogFormatter.todo.defaultHighlight": {
                    "type": "object",
                    "default": {},
                    "description": "所有标签的默认高亮配置（foreground/background/gutterIcon/highlightType）"
                },
                "verilogFormatter.todo.customHighlight": {
                    "type": "object",
                    "default": {},
                    "description": "各标签的个性化高亮配置，键为标签名"
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "jest",
        "package": "vsce package",
        "vscode:prepublish": "npm run compile"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
            "**/test/**/*.test.ts"
        ],
        "moduleNameMapper": {
            "^vscode$": "<rootDir>/test/mocks/vscode.js"
        }
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/jest": "^29.0.0",
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.80.0",
        "jest": "^29.0.0",
        "ts-jest": "^29.0.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "@vscode/ripgrep": "^1.18.0",
        "@vscode/ripgrep-win32-x64": "^1.18.0",
        "glob": "^10.5.0"
    }
}
