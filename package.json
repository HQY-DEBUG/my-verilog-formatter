{
    "name": "hanxuyao-plugin",
    "displayName": "hanxuyao-plugin",
    "description": "Verilog / SystemVerilog / C / C++ 开发工具，内置 MATLAB 编辑、运行调试、工作区、工程与测试支持",
    "version": "1.4.7",
    "publisher": "hanxuyao",
    "repository": {
        "type": "git",
        "url": "https://github.com/HQY-DEBUG/my-verilog-formatter.git"
    },
    "keywords": [
        "verilog",
        "systemverilog",
        "formatter",
        "fpga",
        "matlab"
    ],
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Formatters",
        "Programming Languages",
        "Linters"
    ],
    "activationEvents": [
        "onLanguage:verilog",
        "onLanguage:systemverilog",
        "onLanguage:verilog-hdl",
        "onLanguage:systemverilog-hdl",
        "onLanguage:c",
        "onLanguage:cpp",
        "onLanguage:matlab",
        "onCommand:verilogFormatter.formatDocument",
        "onLanguage:ucf",
        "onLanguage:xdc",
        "onLanguage:anlogic-adc",
        "onLanguage:sdc",
        "onLanguage:vhdl",
        "onLanguage:tcl",
        "onLanguage:modelsim-do",
        "onLanguage:gowin-cst",
        "onView:verilogFileTree",
        "workspaceContains:**/*.v",
        "workspaceContains:**/*.sv",
        "onView:verilogTodoTree",
        "onStartupFinished",
        "onDebugResolve:matlab",
        "onDebugDynamicConfigurations:matlab",
        "onTerminalProfile:matlab.terminal-profile"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "verilog",
                "aliases": [
                    "Verilog",
                    "verilog"
                ],
                "extensions": [
                    ".v",
                    ".vh"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration-verilog.json"
            },
            {
                "id": "systemverilog",
                "aliases": [
                    "SystemVerilog",
                    "systemverilog"
                ],
                "extensions": [
                    ".sv",
                    ".svh"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration-verilog.json"
            },
            {
                "id": "ucf",
                "aliases": [
                    "UCF Constraint",
                    "ucf"
                ],
                "extensions": [
                    ".ucf"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration.json"
            },
            {
                "id": "xdc",
                "aliases": [
                    "XDC Constraint",
                    "xdc"
                ],
                "extensions": [
                    ".xdc"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration.json"
            },
            {
                "id": "anlogic-adc",
                "aliases": [
                    "Anlogic ADC Constraint",
                    "adc"
                ],
                "extensions": [
                    ".adc"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration.json"
            },
            {
                "id": "sdc",
                "aliases": [
                    "SDC Constraint",
                    "sdc"
                ],
                "extensions": [
                    ".sdc"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration.json"
            },
            {
                "id": "vhdl",
                "aliases": [
                    "VHDL",
                    "vhdl"
                ],
                "extensions": [
                    ".vhd",
                    ".vhdl"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration-vhdl.json"
            },
            {
                "id": "tcl",
                "aliases": [
                    "Tcl",
                    "tcl"
                ],
                "extensions": [
                    ".tcl"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration.json"
            },
            {
                "id": "modelsim-do",
                "aliases": [
                    "ModelSim DO",
                    "do"
                ],
                "extensions": [
                    ".do"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration.json"
            },
            {
                "id": "gowin-cst",
                "aliases": [
                    "GoWin CST",
                    "cst"
                ],
                "extensions": [
                    ".cst"
                ],
                "configuration": "./resources/verilog/language-configurations/language-configuration.json"
            },
            {
                "id": "matlab",
                "aliases": [
                    "MATLAB",
                    "matlab"
                ],
                "extensions": [
                    ".m"
                ],
                "configuration": "./out/matlab/language-configuration.json",
                "icon": {
                    "light": "./out/matlab/public/fileIcon_24x24.png",
                    "dark": "./out/matlab/public/fileIcon_24x24.png"
                }
            }
        ],
        "snippets": [
            {
                "language": "verilog",
                "path": "./resources/verilog/snippets/verilog.code-snippets"
            },
            {
                "language": "systemverilog",
                "path": "./resources/verilog/snippets/verilog.code-snippets"
            },
            {
                "language": "matlab",
                "path": "./out/matlab/snippets/matlab.json"
            }
        ],
        "grammars": [
            {
                "language": "verilog",
                "scopeName": "source.verilog",
                "path": "./resources/verilog/syntaxes/verilog.tmLanguage.json"
            },
            {
                "language": "verilog-hdl",
                "scopeName": "source.verilog.hdl",
                "path": "./resources/verilog/syntaxes/verilog.tmLanguage.json"
            },
            {
                "language": "systemverilog",
                "scopeName": "source.systemverilog",
                "path": "./resources/verilog/syntaxes/systemverilog.tmLanguage.json",
                "embeddedLanguages": {
                    "source.verilog": "verilog"
                }
            },
            {
                "language": "systemverilog-hdl",
                "scopeName": "source.systemverilog.hdl",
                "path": "./resources/verilog/syntaxes/systemverilog.tmLanguage.json",
                "embeddedLanguages": {
                    "source.verilog": "verilog-hdl"
                }
            },
            {
                "language": "ucf",
                "scopeName": "source.ucf",
                "path": "./resources/verilog/syntaxes/ucf.tmLanguage.json"
            },
            {
                "language": "xdc",
                "scopeName": "source.xdc",
                "path": "./resources/verilog/syntaxes/xdc.tmLanguage.json"
            },
            {
                "language": "anlogic-adc",
                "scopeName": "source.adc",
                "path": "./resources/verilog/syntaxes/adc.tmLanguage.json"
            },
            {
                "language": "sdc",
                "scopeName": "source.sdc",
                "path": "./resources/verilog/syntaxes/sdc.tmLanguage.json"
            },
            {
                "language": "vhdl",
                "scopeName": "source.vhdl",
                "path": "./resources/verilog/syntaxes/vhdl.tmLanguage.json"
            },
            {
                "language": "tcl",
                "scopeName": "source.tcl",
                "path": "./resources/verilog/syntaxes/tcl.tmLanguage.json"
            },
            {
                "language": "modelsim-do",
                "scopeName": "source.do",
                "path": "./resources/verilog/syntaxes/do.tmLanguage.json"
            },
            {
                "language": "gowin-cst",
                "scopeName": "source.cst",
                "path": "./resources/verilog/syntaxes/cst.tmLanguage.json"
            },
            {
                "language": "matlab",
                "scopeName": "source.matlab",
                "path": "./out/matlab/syntaxes/Matlab.tmbundle/Syntaxes/MATLAB.tmLanguage"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "verilogFileTree",
                    "name": "Verilog 文件树",
                    "when": "workbenchState != empty"
                },
                {
                    "id": "verilogTodoTree",
                    "name": "TODO",
                    "when": "workbenchState != empty"
                }
            ],
            "matlabSidebar": [
                {
                    "id": "workspaceBrowserSidebarView",
                    "name": "Workspace",
                    "type": "webview",
                    "icon": "./out/matlab/public/logo_outline.svg"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "verilogFormatter.refreshFileTree",
                    "when": "view == verilogFileTree",
                    "group": "navigation"
                },
                {
                    "command": "verilogFormatter.setTopModule",
                    "when": "view == verilogFileTree",
                    "group": "navigation"
                },
                {
                    "command": "verilogFormatter.todo.refresh",
                    "when": "view == verilogTodoTree",
                    "group": "navigation@1"
                },
                {
                    "command": "verilogFormatter.todo.collapseAll",
                    "when": "view == verilogTodoTree",
                    "group": "navigation@2"
                },
                {
                    "command": "verilogFormatter.todo.setViewTree",
                    "when": "view == verilogTodoTree",
                    "group": "navigation@3"
                },
                {
                    "command": "verilogFormatter.todo.setViewFlat",
                    "when": "view == verilogTodoTree",
                    "group": "navigation@4"
                },
                {
                    "command": "verilogFormatter.todo.setViewTags",
                    "when": "view == verilogTodoTree",
                    "group": "navigation@5"
                },
                {
                    "command": "verilogFormatter.todo.filterClear",
                    "when": "view == verilogTodoTree",
                    "group": "navigation@6"
                },
                {
                    "command": "matlab.testing.addTestFolder",
                    "when": "view == workbench.view.testing && matlab.testing.isActive",
                    "group": "navigation@1"
                },
                {
                    "command": "matlab.testing.addTestFile",
                    "when": "view == workbench.view.testing && matlab.testing.isActive",
                    "group": "navigation@2"
                }
            ],
            "view/item/context": [
                {
                    "command": "verilogFormatter.todo.hidePath",
                    "when": "view == verilogTodoTree && viewItem == todoFile",
                    "group": "todo@1"
                },
                {
                    "command": "verilogFormatter.todo.hidePath",
                    "when": "view == verilogTodoTree && viewItem == todoFolder",
                    "group": "todo@1"
                },
                {
                    "command": "verilogFormatter.todo.resetPathFilter",
                    "when": "view == verilogTodoTree",
                    "group": "todo@2"
                }
            ],
            "editor/context": [
                {
                    "command": "verilogFormatter.instantiate",
                    "when": "editorLangId =~ /verilog|systemverilog/",
                    "group": "verilog@1"
                },
                {
                    "command": "verilogFormatter.generateTb",
                    "when": "editorLangId =~ /verilog|systemverilog/",
                    "group": "verilog@2"
                },
                {
                    "command": "verilogFormatter.ucfToXdc",
                    "when": "editorLangId == ucf",
                    "group": "verilog@3"
                },
                {
                    "command": "matlab.runFile",
                    "when": "editorLangId == matlab && resourceScheme != 'untitled' && !matlab.isDebugging",
                    "group": "1_run"
                },
                {
                    "command": "matlab.runSection",
                    "when": "editorLangId == matlab && !matlab.isDebugging",
                    "group": "2_run"
                },
                {
                    "command": "matlab.runSelection",
                    "when": "editorLangId == matlab && editorHasSelection && !editorHasMultipleSelections && !matlab.isDebugging",
                    "group": "3_run"
                }
            ],
            "commandPalette": [
                {
                    "command": "matlab.addFolderToPath",
                    "when": "false"
                },
                {
                    "command": "matlab.addFolderAndSubfoldersToPath",
                    "when": "false"
                },
                {
                    "command": "matlab.changeDirectory",
                    "when": "false"
                },
                {
                    "command": "matlab.testing.removeTestItem",
                    "when": "false"
                },
                {
                    "command": "matlab.wsb.editValue",
                    "when": "false"
                },
                {
                    "command": "matlab.wsb.deleteVariable",
                    "when": "false"
                },
                {
                    "command": "matlab.wsb.renameVariable",
                    "when": "false"
                },
                {
                    "command": "matlab.wsb.sortAscending",
                    "when": "false"
                },
                {
                    "command": "matlab.wsb.sortDescending",
                    "when": "false"
                }
            ],
            "testing/item/context": [
                {
                    "command": "matlab.testing.removeTestItem",
                    "group": "matlab@1",
                    "when": "controllerId == matlab-tests"
                }
            ],
            "editor/title/run": [
                {
                    "command": "matlab.runFile",
                    "when": "editorLangId == matlab && resourceScheme != 'untitled' && !matlab.isDebugging",
                    "group": "1_run"
                },
                {
                    "command": "matlab.runSection",
                    "when": "editorLangId == matlab && !matlab.isDebugging",
                    "group": "2_run"
                },
                {
                    "command": "matlab.runSelection",
                    "when": "editorLangId == matlab && editorHasSelection && !editorHasMultipleSelections && !matlab.isDebugging",
                    "group": "3_run"
                }
            ],
            "explorer/context": [
                {
                    "submenu": "matlab.addPath",
                    "when": "explorerResourceIsFolder",
                    "group": "matlab"
                },
                {
                    "submenu": "matlab.project",
                    "when": "explorerResourceIsFolder || resourceExtname == .prj || resourceFilename == matlab.toml",
                    "group": "matlab"
                },
                {
                    "command": "matlab.changeDirectory",
                    "when": "explorerResourceIsFolder",
                    "group": "matlab"
                },
                {
                    "command": "matlab.openFile",
                    "when": "!explorerResourceIsFolder",
                    "group": "files"
                }
            ],
            "matlab.addPath": [
                {
                    "command": "matlab.addFolderToPath",
                    "when": "explorerResourceIsFolder"
                },
                {
                    "command": "matlab.addFolderAndSubfoldersToPath",
                    "when": "explorerResourceIsFolder"
                }
            ],
            "webview/context": [
                {
                    "command": "matlab.wsb.deleteVariable",
                    "when": "webviewId == 'workspaceBrowserSidebarView' && webviewSection == 'row'",
                    "group": "wsb_row@2"
                },
                {
                    "command": "matlab.wsb.renameVariable",
                    "when": "webviewId == 'workspaceBrowserSidebarView' && webviewSection == 'row'",
                    "group": "wsb_row@3"
                },
                {
                    "command": "matlab.wsb.editValue",
                    "when": "webviewId == 'workspaceBrowserSidebarView' && webviewSection == 'row'",
                    "group": "wsb_row@4"
                },
                {
                    "command": "matlab.wsb.sortAscending",
                    "when": "webviewId == 'workspaceBrowserSidebarView' && webviewSection == 'header'"
                },
                {
                    "command": "matlab.wsb.sortDescending",
                    "when": "webviewId == 'workspaceBrowserSidebarView' && webviewSection == 'header'"
                }
            ],
            "matlab.project": [
                {
                    "command": "matlab.project.new",
                    "when": "explorerResourceIsFolder",
                    "group": "matlab_project@0"
                },
                {
                    "command": "matlab.project.open",
                    "when": "explorerResourceIsFolder || resourceExtname == .prj || resourceFilename == matlab.toml",
                    "group": "matlab_project@1"
                },
                {
                    "command": "matlab.project.close",
                    "when": "explorerResourceIsFolder || resourceExtname == .prj || resourceFilename == matlab.toml",
                    "group": "matlab_project@2"
                }
            ]
        },
        "commands": [
            {
                "command": "verilogFormatter.formatDocument",
                "title": "hanxuyao-plugin: 格式化当前文档"
            },
            {
                "command": "verilogFormatter.instantiate",
                "title": "Verilog: 一键例化（复制到剪贴板）"
            },
            {
                "command": "verilogFormatter.generateTb",
                "title": "Verilog: 一键生成 Testbench"
            },
            {
                "command": "verilogFormatter.refreshFileTree",
                "title": "Verilog: 刷新文件树",
                "icon": "$(refresh)"
            },
            {
                "command": "verilogFormatter.setTopModule",
                "title": "Verilog: 设置顶层模块",
                "icon": "$(star)"
            },
            {
                "command": "verilogFormatter.rebuildIndex",
                "title": "Verilog: 重建符号索引"
            },
            {
                "command": "verilogFormatter.ucfToXdc",
                "title": "Verilog: UCF 转 XDC"
            },
            {
                "command": "verilogFormatter.incrementNumbers",
                "title": "Verilog: 数字递增 (+step)"
            },
            {
                "command": "verilogFormatter.decrementNumbers",
                "title": "Verilog: 数字递减 (-step)"
            },
            {
                "command": "verilogFormatter.todo.refresh",
                "title": "TODO: 刷新",
                "icon": "$(refresh)"
            },
            {
                "command": "verilogFormatter.todo.addTag",
                "title": "TODO: 添加标签"
            },
            {
                "command": "verilogFormatter.todo.removeTag",
                "title": "TODO: 删除标签"
            },
            {
                "command": "verilogFormatter.todo.diagnose",
                "title": "TODO: 诊断（显示当前扫描状态）"
            },
            {
                "command": "verilogFormatter.todo.goToNext",
                "title": "TODO: 跳到下一个"
            },
            {
                "command": "verilogFormatter.todo.goToPrevious",
                "title": "TODO: 跳到上一个"
            },
            {
                "command": "verilogFormatter.todo.setViewTree",
                "title": "TODO: 树视图",
                "icon": "$(list-tree)"
            },
            {
                "command": "verilogFormatter.todo.setViewFlat",
                "title": "TODO: 平铺列表",
                "icon": "$(list-flat)"
            },
            {
                "command": "verilogFormatter.todo.setViewTags",
                "title": "TODO: 按标签分组",
                "icon": "$(tag)"
            },
            {
                "command": "verilogFormatter.todo.filterClear",
                "title": "TODO: 清除过滤",
                "icon": "$(clear-all)"
            },
            {
                "command": "verilogFormatter.todo.collapseAll",
                "title": "TODO: 折叠全部",
                "icon": "$(collapse-all)"
            },
            {
                "command": "verilogFormatter.todo.hidePath",
                "title": "TODO: 隐藏此路径"
            },
            {
                "command": "verilogFormatter.todo.resetPathFilter",
                "title": "TODO: 重置路径过滤"
            },
            {
                "command": "matlab.changeMatlabConnection",
                "title": "MATLAB: Change MATLAB Connection"
            },
            {
                "command": "matlab.runFile",
                "title": "MATLAB: Run File",
                "icon": "$(play)",
                "when": "!matlab.isDebugging"
            },
            {
                "command": "matlab.runSection",
                "title": "MATLAB: Run Current Section",
                "icon": "$(play)",
                "when": "!matlab.isDebugging"
            },
            {
                "command": "matlab.runSelection",
                "title": "MATLAB: Run Current Selection",
                "icon": "$(play)",
                "when": "!matlab.isDebugging"
            },
            {
                "command": "matlab.openCommandWindow",
                "title": "MATLAB: Open Command Window",
                "icon": "$(output)"
            },
            {
                "command": "matlab.interrupt",
                "title": "MATLAB: Interrupt"
            },
            {
                "command": "matlab.addFolderToPath",
                "title": "Selected Folder"
            },
            {
                "command": "matlab.addFolderAndSubfoldersToPath",
                "title": "Selected Folder and Subfolders"
            },
            {
                "command": "matlab.changeDirectory",
                "title": "MATLAB: Change current directory"
            },
            {
                "command": "matlab.enableSignIn",
                "title": "MATLAB: Manage Sign In Options"
            },
            {
                "command": "matlab.openFile",
                "title": "MATLAB: Open File"
            },
            {
                "command": "matlab.resetDeprecationPopups",
                "title": "MATLAB: Reset Deprecation Warning Popups"
            },
            {
                "command": "matlab.showLanguageServerOutput",
                "title": "MATLAB: Show Language Server Output"
            },
            {
                "command": "matlab.wsb.editValue",
                "title": "Edit Value"
            },
            {
                "command": "matlab.wsb.deleteVariable",
                "title": "Delete"
            },
            {
                "command": "matlab.wsb.renameVariable",
                "title": "Rename"
            },
            {
                "command": "matlab.wsb.sortAscending",
                "title": "Sort Ascending"
            },
            {
                "command": "matlab.wsb.sortDescending",
                "title": "Sort Descending"
            },
            {
                "command": "matlab.project.open",
                "title": "MATLAB: Open Project..."
            },
            {
                "command": "matlab.project.close",
                "title": "MATLAB: Close Project",
                "enablement": "matlab.project.isOpen"
            },
            {
                "command": "matlab.project.new",
                "title": "MATLAB: New Project..."
            },
            {
                "command": "matlab.project.actions",
                "title": "MATLAB: Project Actions..."
            },
            {
                "command": "matlab.testing.runAllTests",
                "title": "MATLAB: Run All Tests"
            },
            {
                "command": "matlab.testing.discoverTests",
                "title": "MATLAB: Discover Tests"
            },
            {
                "command": "matlab.testing.addTestFolder",
                "title": "Add Test Folder",
                "category": "MATLAB",
                "icon": "$(new-folder)"
            },
            {
                "command": "matlab.testing.addTestFile",
                "title": "Add Test File",
                "category": "MATLAB",
                "icon": "$(new-file)"
            },
            {
                "command": "matlab.testing.removeTestItem",
                "title": "Remove Test",
                "icon": "$(trash)"
            }
        ],
        "keybindings": [
            {
                "command": "verilogFormatter.formatDocument",
                "key": "ctrl+alt+f",
                "when": "editorTextFocus && editorLangId =~ /verilog|systemverilog|anlogic-adc|c|cpp|matlab/"
            },
            {
                "command": "verilogFormatter.instantiate",
                "key": "ctrl+alt+i",
                "when": "editorTextFocus && editorLangId =~ /verilog|systemverilog/"
            },
            {
                "command": "verilogFormatter.incrementNumbers",
                "key": "ctrl+alt+up",
                "when": "editorTextFocus"
            },
            {
                "command": "verilogFormatter.decrementNumbers",
                "key": "ctrl+alt+down",
                "when": "editorTextFocus"
            },
            {
                "command": "matlab.runFile",
                "key": "f5",
                "when": "editorTextFocus && editorLangId == matlab && !findInputFocussed && !replaceInputFocussed && resourceScheme != 'untitled' && !matlab.isDebugging"
            },
            {
                "command": "matlab.runSection",
                "key": "Ctrl+enter",
                "when": "editorTextFocus && editorLangId == matlab && !findInputFocussed && !replaceInputFocussed && !matlab.isDebugging"
            },
            {
                "command": "matlab.runSelection",
                "key": "shift+enter",
                "when": "editorTextFocus && editorHasSelection && !editorHasMultipleSelections && editorLangId == matlab && !findInputFocussed && !replaceInputFocussed && !matlab.isDebugging"
            },
            {
                "command": "matlab.interrupt",
                "key": "Ctrl+C",
                "when": "((editorTextFocus && !editorHasSelection && editorLangId == matlab) || (terminalFocus && matlab.isActiveTerminal && !matlab.terminalHasSelection && !terminalTextSelectedInFocused))"
            },
            {
                "command": "matlab.wsb.deleteVariable",
                "key": "delete",
                "when": "focusedView == 'workspaceBrowserSidebarView'"
            },
            {
